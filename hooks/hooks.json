{
  "description": "bentoo-dev: deterministic safety, lint, and Manifest-staleness gates for Gentoo overlays. Every hook uses exec form (\"args\": []) so the command is spawned directly, with no shell to quote paths for.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/cache-overlay.sh",
            "timeout": 10,
            "args": [],
            "statusMessage": "Detecting Gentoo overlay…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/cleanup-cache.sh",
            "timeout": 5,
            "args": [],
            "statusMessage": "Clearing overlay cache…"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/cache-overlay.sh",
            "timeout": 10,
            "args": [],
            "statusMessage": "Detecting Gentoo overlay…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-title.sh",
            "timeout": 5,
            "args": [],
            "statusMessage": "Naming session…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(rm *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/safety-rm-check.sh",
            "args": [],
            "statusMessage": "Checking ebuild removal safety…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git rm *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/safety-rm-check.sh",
            "args": [],
            "statusMessage": "Checking ebuild removal safety…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/quick-lint.sh",
            "args": [],
            "statusMessage": "Linting ebuild…"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/manifest-reminder.sh",
            "args": [],
            "statusMessage": "Checking Manifest freshness…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(cp *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/quick-lint.sh",
            "args": [],
            "statusMessage": "Linting ebuild…"
          },
          {
            "type": "command",
            "if": "Bash(mv *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/quick-lint.sh",
            "args": [],
            "statusMessage": "Linting ebuild…"
          },
          {
            "type": "command",
            "if": "Bash(sed *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/quick-lint.sh",
            "args": [],
            "statusMessage": "Linting ebuild…"
          },
          {
            "type": "command",
            "if": "Bash(cp *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/manifest-reminder.sh",
            "args": [],
            "statusMessage": "Checking Manifest freshness…"
          },
          {
            "type": "command",
            "if": "Bash(mv *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/manifest-reminder.sh",
            "args": [],
            "statusMessage": "Checking Manifest freshness…"
          },
          {
            "type": "command",
            "if": "Bash(sed *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/manifest-reminder.sh",
            "args": [],
            "statusMessage": "Checking Manifest freshness…"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/manifest-failure-diagnose.sh",
            "args": [],
            "statusMessage": "Diagnosing manifest failure…"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "ebuild-creator",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/ebuild-creator-validate.sh",
            "args": [],
            "statusMessage": "Verifying created package…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/manifest-stale-check.sh",
            "args": [],
            "statusMessage": "Checking for stale Manifests…"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/stopfailure-log.sh",
            "args": [],
            "statusMessage": "Logging turn failure…"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/precompact-reinject-overlay.sh",
            "args": [],
            "statusMessage": "Preserving overlay context…"
          }
        ]
      }
    ]
  }
}
